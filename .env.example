# Google Cloud Vision API Key
# Get your API key from: https://console.cloud.google.com
# Instructions:
# 1. Create a project in Google Cloud Console
# 2. Enable Cloud Vision API
# 3. Create an API key in Credentials
# 4. Copy the key and paste below

VITE_GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here

# Maintenance Mode
# Set to 'true' to enable maintenance screen, 'false' to disable
VITE_MAINTENANCE_MODE=false
# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
# Instructions:
# 1. Create a project in Supabase
# 2. Go to Project Settings > API
# 3. Copy the Project URL and anon/public key

VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: API keys in Vite must start with VITE_ prefix
# This file is just an example - create a .env file with your actual key
# Never commit your actual .env file to version control
