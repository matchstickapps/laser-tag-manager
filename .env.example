# Google Cloud Vision API Key (Server-side only - more secure)
# Get your API key from: https://console.cloud.google.com
# Instructions:
# 1. Create a project in Google Cloud Console
# 2. Enable Cloud Vision API
# 3. Create an API key in Credentials
# 4. Copy the key and paste below

GOOGLE_CLOUD_VISION_API_KEY=your_api_key_here

# Maintenance Mode
# Set to 'true' to enable maintenance screen, 'false' to disable
VITE_MAINTENANCE_MODE=false
# Supabase Configuration
# Supabase Configuration (Server-side only - more secure)
# Get these values from your Supabase project settings: https://app.supabase.com
# Instructions:
# 1. Create a project in Supabase
# 2. Go to Project Settings > API
# 3. Copy the Project URL and anon/public key

SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Note: These variables are server-side only (no NEXT_PUBLIC_ prefix)
# They will only be accessible in API routes and server components
# Copy this file to .env.local with your actual values
# Never commit your actual .env.local file to version control
